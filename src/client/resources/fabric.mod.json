{
  "schemaVersion": 1,
  "id": "multifeature-mod",
  "version": "${version}",
  "name": "MultiFeature Client Mod",
  "description": "Simple low-RAM client mod: KillAura + reach, no-jump crits, auto totem, fullbright + visual toggles. Singleplayer/private only.",
  "authors": ["The-Silent-Voyager-coder"],
  "license": "All Rights Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.multifeature.MultiFeatureMod"]
  },
  "mixins": ["multifeaturemod.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api-base": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-command-api-v2": "*",
    "fabric-rendering-v1": "*",
    "fabric-message-api-v1": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
